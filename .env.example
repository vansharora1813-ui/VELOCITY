# The Living Blueprint — Server Environment Variables
# Copy this file to .env and provide your API key.
# IMPORTANT: API keys are used server-side only and never exposed to the client bundle.

# Google Gemini API key (Primary Provider)
# Obtain a free API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model selection for primary provider (default: gemini-3.8-flash)
AI_MODEL=gemini-3.8-flash

# Groq API key (Automatic Fallback Provider)
# Obtain a free API key from Groq Console: https://console.groq.com/keys
# Note: Groq free tier is subject to bounded RPM/TPM rate limits (not unlimited).
GROQ_API_KEY=your_groq_api_key_here

# Model selection for fallback provider (default: qwen/qwen3.8-27b)
GROQ_MODEL=qwen/qwen3.8-27b
