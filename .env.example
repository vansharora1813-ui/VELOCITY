# The Living Blueprint — Server Environment Variables
# Copy this file to .env and provide your API key.
# IMPORTANT: API keys are used server-side only and never exposed to the client bundle.

# Google Gemini API key
# Obtain an API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model selection (default: gemini-3.8-flash)
AI_MODEL=gemini-3.8-flash
